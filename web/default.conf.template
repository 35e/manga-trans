server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # A page and its mask go up together and the cleaned page comes back, so the
    # 32 MB the API accepts has to get past nginx first. Its own default is 1 MB,
    # which shows up as a 413 on exactly the large scans that need cleaning most.
    client_max_body_size 32m;

    # Re-resolved as requests come in, rather than once at start.
    #
    # Written `proxy_pass http://api:8000`, nginx looks the name up when it loads
    # its config and keeps that address for the life of the process. The API
    # container gets a new address every time it is recreated — a crash, a
    # `compose up`, a restart — and from then on nginx holds the old one and
    # answers *everything* with 502, including the pages that were fine. It reads
    # as "the API is down" long after it has come back.
    #
    # A name held in a variable is looked up per request instead, which needs a
    # resolver named: the one the container itself was given, filled in from
    # /etc/resolv.conf by the nginx image's own entrypoint. $request_uri has to
    # be spelled out because a proxy_pass with a variable in it does not pass the
    # path on by itself.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # The API, on the same origin as the dashboard. This is the whole reason the
    # front end is served rather than handed out by `vite dev`: same origin means
    # no preflight, no MANGA_TRANS_ORIGIN, and one port to publish.
    location /api/ {
        set $upstream "api";
        proxy_pass http://$upstream:8000$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Reading a page is seconds and translating a folder is minutes; the
        # default 60s cuts a page off mid-answer and the dashboard reports it as
        # the API being unreachable.
        proxy_connect_timeout 30s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;

        # The answers are whole PNGs built in memory. Buffering them to disk
        # before passing them on buys nothing here.
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Vite fingerprints everything under /assets, so those can be kept for good.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # A single-page app: anything that is not a file is still index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
