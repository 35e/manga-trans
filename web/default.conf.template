server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Past nginx's 1 MB default, or large scans 413. The API accepts 32 MB.
    client_max_body_size 32m;

    # The upstream is held in a variable so it is re-resolved per request. Do not
    # simplify this to `proxy_pass http://api:8000` — nginx would then hold the
    # API's address for the life of the process and 502 everything after a
    # restart. The explicit $request_uri is needed for the same reason. DOCS.md.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # The API, on the same origin as the dashboard.
    location /api/ {
        set $upstream "api";
        proxy_pass http://$upstream:8000$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Past the 60s default, which cuts a page off mid-answer.
        proxy_connect_timeout 30s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;

        # The answers are whole PNGs built in memory.
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Vite fingerprints everything under /assets, so those can be kept for good.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # A single-page app: anything that is not a file is still index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
